{
  "name": "bellmare-333",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "start": "vite preview --host 0.0.0.0",
    "fmt": "prettier --check src tests *.ts index.html",
    "fmt:fix": "prettier --write src tests *.ts index.html"
  },
  "dependencies": {
    "playcanvas": "2.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
